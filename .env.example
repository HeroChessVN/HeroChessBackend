# === Database ===
# Local development PostgreSQL via docker-compose.yml (docker compose up -d postgres)
ConnectionStrings__DefaultConnection=Host=localhost;Port=55432;Database=hero_chess;Username=hero_chess;Password=change-me
HERO_CHESS_DB_PASSWORD=change-me

# === Bootstrap ===
DatabaseBootstrap__Enabled=true
DatabaseBootstrap__SeedDevelopmentFixtures=true

# === Onboarding ===
Onboarding__GrantDevelopmentFixtureHeroes=true
