{
  "DatabaseBootstrap": {
    "Enabled": false,
    "SeedDevelopmentFixtures": false,
    "IsProductionDatabase": true
  },

  "Onboarding": {
    "GrantDevelopmentFixtureHeroes": false,
    "StartingElo": 1000,
    "DevelopmentStartingCoins": 0,
    "DevelopmentAdminEmails": []
  },

  "Matchmaking": {
    "EloWindow": 200
  },
  "MatchRuntime": {
    "WebSocketTicketSeconds": 30,
    "MaxWebSocketMessageBytes": 65536,
    "TimeoutPollMilliseconds": 500,
    "WinnerCoinReward": 10,
    "DrawCoinReward": 5,
    "EloKFactor": 32,
    "BotThinkMilliseconds": 250
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
