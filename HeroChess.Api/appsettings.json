{
  "DatabaseBootstrap": {
    "Enabled": false,
    "SeedDevelopmentFixtures": false,
    "IsProductionDatabase": true
  },

  "Onboarding": {
    "GrantDevelopmentFixtureHeroes": false,
    "StartingElo": 1000,
    "DevelopmentStartingCoins": 0,
    "DevelopmentAdminEmails": []
  },

  "Matchmaking": {
    "EloWindow": 200
  },
  "MatchRuntime": {
    "HeroTraitsEnabled": true,
    "WebSocketTicketSeconds": 30,
    "MaxWebSocketMessageBytes": 65536,
    "TimeoutPollMilliseconds": 500,
    "WinnerCoinReward": 10,
    "DrawCoinReward": 5,
    "EloKFactor": 32,
    "BotThinkMilliseconds": 250,
    "BotWorkerCount": 1
  },

  "ReverseProxy": {
    "KnownProxies": ["172.17.0.1"]
  },
  "TrafficLimits": {
    "MaxSocketsPerAccount": 2,
    "MaxSockets": 256,
    "MaxHttpInFlight": 32,
    "MaxPendingTickets": 512
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
